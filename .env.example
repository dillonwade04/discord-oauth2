# Discord OAuth application
DISCORD_CLIENT_ID=replace_with_your_discord_client_id
DISCORD_CLIENT_SECRET=replace_with_a_new_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:5000/callback
DISCORD_INVITE_URL=replace_with_your_discord_invite_url

# Optional login notification webhook
DISCORD_WEBHOOK_URL=

# Shared only with trusted services that call GET /check
OAUTH_API_SECRET=replace_with_a_long_random_value

# Used to sign OAuth state session cookies
FLASK_SECRET_KEY=replace_with_a_different_long_random_value

# Production deployments can point this at a persistent private volume
AUTHORIZED_USERS_FILE=data/authorized_users.json
